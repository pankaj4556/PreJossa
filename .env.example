# Server Port (default: 3000)
PORT=3000
NODE_ENV=development

# Razorpay Test Mode Credentials
# Public Key ID (shared with frontend checkout)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
# Private Key Secret (Keep confidential, server-side verification only)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Webhook Secret (Set up in Razorpay Dashboard -> Webhooks for event verification)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Admin Security & Secret Portal Path (Keep strictly private in .env - do NOT commit)
# Define your own secret URL path for the admin portal, e.g. /my-secret-admin
ADMIN_ROUTE_PATH=/admin
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_secure_admin_password
SESSION_SECRET=your_random_session_secret_key
