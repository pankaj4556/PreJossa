    </div>

    <div class="mt-12 text-center">
      <a href="/generator" class="inline-flex items-center space-x-2 px-8 py-4 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-base shadow-lg transition transform hover:-translate-y-0.5">
