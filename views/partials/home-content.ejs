        <span>Explore all 54 institutes</span>
        <i data-lucide="arrow-right" class="w-4 h-4 transform group-hover:translate-x-1 transition"></i>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% topInstitutes.forEach(inst => { %>
        <div class="bg-white border border-slate-200/90 rounded-2xl p-6 hover:border-blue-400 hover:shadow-lg transition-all flex flex-col justify-between group">
          <div>
            <div class="flex items-start justify-between mb-3.5">
              <span class="px-2.5 py-0.5 rounded-md text-xs font-bold font-mono tracking-wider <%= inst.type === 'IIT' ? 'bg-indigo-50 text-indigo-700 border border-indigo-200' : 'bg-amber-50 text-amber-800 border border-amber-200' %>">
                <%= inst.type %>
              </span>
              <span class="text-xs font-extrabold text-slate-700 bg-slate-100 px-2.5 py-1 rounded-md font-mono">
                NIRF #<%= inst.nirf_rank || '-' %>
              </span>
            </div>

            <h3 class="text-lg font-bold text-slate-900 mb-1 group-hover:text-blue-600 transition line-clamp-1">
              <%= inst.name %>
            </h3>

            <p class="text-xs text-slate-500 mb-5 flex items-center space-x-1.5">
              <i data-lucide="map-pin" class="w-3.5 h-3.5 text-slate-400"></i>
              <span><%= inst.city %>, <%= inst.state %></span>
            </p>

            <div class="grid grid-cols-2 gap-3 p-3 rounded-xl bg-slate-50 border border-slate-100 text-xs">
              <div>
                <span class="text-slate-400 block text-[10px] font-bold uppercase tracking-wider">Avg Package</span>
                <span class="font-extrabold text-slate-900 font-mono text-sm">
                  <%= inst.average_package_lpa ? '₹' + inst.average_package_lpa + ' LPA' : 'N/A' %>
                </span>
              </div>
              <div>
                <span class="text-slate-400 block text-[10px] font-bold uppercase tracking-wider">Highest Package</span>
                <span class="font-extrabold text-slate-900 font-mono text-sm">
                  <%= inst.highest_package_lpa ? '₹' + inst.highest_package_lpa + ' LPA' : 'N/A' %>
                </span>
              </div>
            </div>
          </div>

          <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between">
            <span class="text-[11px] font-mono text-slate-400">JoSAA Code: <%= inst.josaa_code %></span>
            <a href="/college/<%= inst.josaa_code %>" class="text-xs font-bold text-blue-600 hover:text-blue-800 flex items-center space-x-1">
              <span>View Cutoffs</span>
              <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
            </a>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

