<!-- Premier Institutes Showcase -->
<section class="section-institutes py-16 lg:py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 reveal-on-scroll">
