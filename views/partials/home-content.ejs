      { type: 'IIT', college: 'IIT Guwahati', branch: 'Mathematics & Computing', code: 'MNC', cr: 1100, nirf: 7 },
      { type: 'NIT', college: 'NIT Warangal', branch: 'Mathematics & Computing', code: 'MNC', cr: 4200, nirf: 21 },
      { type: 'NIT', college: 'NIT Hamirpur', branch: 'Mathematics & Computing', code: 'MNC', cr: 13800, nirf: 68 },

      // ECE
      { type: 'IIT', college: 'IIT Bombay', branch: 'Electrical & Electronics', code: 'ECE', cr: 450, nirf: 3 },
      { type: 'IIT', college: 'IIT Roorkee', branch: 'Electronics & Comm. Eng.', code: 'ECE', cr: 1450, nirf: 8 },
      { type: 'IIT', college: 'IIT Guwahati', branch: 'Electronics & Comm. Eng.', code: 'ECE', cr: 1750, nirf: 7 },
      { type: 'NIT', college: 'NIT Trichy', branch: 'Electronics & Comm. Eng.', code: 'ECE', cr: 3200, nirf: 9 },
      { type: 'NIT', college: 'NIT Surathkal', branch: 'Electronics & Comm. Eng.', code: 'ECE', cr: 4100, nirf: 12 },
      { type: 'NIT', college: 'NIT Rourkela', branch: 'Electronics & Comm. Eng.', code: 'ECE', cr: 6500, nirf: 19 },
      { type: 'NIT', college: 'MNIT Jaipur', branch: 'Electronics & Comm. Eng.', code: 'ECE', cr: 9800, nirf: 43 },
      { type: 'NIT', college: 'NIT Silchar', branch: 'Electronics & Comm. Eng.', code: 'ECE', cr: 16800, nirf: 40 },

      // MECH
      { type: 'IIT', college: 'IIT Bombay', branch: 'Mechanical Engineering', code: 'MECH', cr: 1750, nirf: 3 },
      { type: 'IIT', college: 'IIT Delhi', branch: 'Mechanical Engineering', code: 'MECH', cr: 1900, nirf: 2 },
      { type: 'IIT', college: 'IIT Madras', branch: 'Mechanical Engineering', code: 'MECH', cr: 2450, nirf: 1 },
      { type: 'IIT', college: 'IIT Kharagpur', branch: 'Mechanical Engineering', code: 'MECH', cr: 3200, nirf: 5 },
      { type: 'NIT', college: 'NIT Trichy', branch: 'Mechanical Engineering', code: 'MECH', cr: 7200, nirf: 9 },
      { type: 'NIT', college: 'NIT Surathkal', branch: 'Mechanical Engineering', code: 'MECH', cr: 9500, nirf: 12 },
      { type: 'NIT', college: 'NIT Warangal', branch: 'Mechanical Engineering', code: 'MECH', cr: 11000, nirf: 21 },
      { type: 'NIT', college: 'NIT Calicut', branch: 'Mechanical Engineering', code: 'MECH', cr: 15500, nirf: 25 },
      { type: 'NIT', college: 'VNIT Nagpur', branch: 'Mechanical Engineering', code: 'MECH', cr: 18500, nirf: 39 }
    ];

    let currentType = 'BOTH';
    let currentBranch = 'CSE';
    let currentRank = 4200;

    const rankSlider = document.getElementById('demoRankSlider');
    const rankDisplay = document.getElementById('demoRankDisplay');
    const resultsContainer = document.getElementById('demoResultsList');

    function updateDemo() {
      if (!rankDisplay || !resultsContainer) return;
      rankDisplay.textContent = '#' + Number(currentRank).toLocaleString();

      // Filter by type and branch
      let filtered = samplePool.filter(item => {
        const typeMatch = (currentType === 'BOTH') || (item.type === currentType);
        const branchMatch = item.code === currentBranch;
        return typeMatch && branchMatch;
      });

      // Compute status for each
      const scored = filtered.map(item => {
        let status = 'Moderate';
        let statusClass = 'bg-amber-900/40 text-amber-300 border-amber-800';
        let ratio = item.cr / currentRank;

        if (ratio < 0.82) {
          status = 'Ambitious';
          statusClass = 'bg-rose-900/40 text-rose-300 border-rose-800';
        } else if (ratio > 1.18) {
          status = 'Safer';
          statusClass = 'bg-emerald-900/40 text-emerald-300 border-emerald-800';
        } else {
          status = 'Target';
          statusClass = 'bg-amber-900/40 text-amber-300 border-amber-800';
        }

        // Distance to user rank
        const diff = Math.abs(item.cr - currentRank);
        return { ...item, status, statusClass, diff };
      });

      // Sort by closing rank (natural JoSAA order)
      scored.sort((a, b) => a.cr - b.cr);

      // Select a realistic 3-4 item sample
      let displayItems = scored.slice(0, 4);
      if (scored.length > 4) {
        const targetIdx = scored.findIndex(s => s.cr >= currentRank);
        const start = Math.max(0, Math.min(scored.length - 4, (targetIdx !== -1 ? targetIdx - 1 : 0)));
        displayItems = scored.slice(start, start + 4);
      }

      if (displayItems.length === 0) {
        resultsContainer.innerHTML = '<div class="p-3 text-center text-xs text-slate-500">No matching programs in demo subset.</div>';
        return;
      }

      let html = '';
      displayItems.forEach((item, idx) => {
        const typeBadge = item.type === 'IIT' 
          ? '<span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-indigo-950 text-indigo-400 border border-indigo-800">IIT</span>'
          : '<span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-amber-950 text-amber-400 border border-amber-800">NIT</span>';

        html += `
          <div class="p-2.5 rounded-xl bg-slate-800/90 border border-slate-700/80 flex items-center justify-between transition-all hover:bg-slate-750">
            <div class="flex items-center space-x-2.5 min-w-0">
              <span class="text-xs font-mono font-bold text-blue-400">#0${idx + 1}</span>
              <div class="min-w-0">
                <div class="flex items-center space-x-1.5">
                  <span class="text-xs font-semibold text-slate-100 truncate">${item.college}</span>
                  ${typeBadge}
                </div>
                <div class="text-[11px] text-slate-400 truncate">${item.branch}</div>
              </div>
            </div>
            <div class="text-right flex flex-col items-end shrink-0 ml-2">
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold border ${item.statusClass}">
                ${item.status}
              </span>
              <span class="text-[10px] font-mono text-slate-400 mt-0.5">CR: ~${item.cr.toLocaleString()}</span>
            </div>
          </div>
        `;
      });

      resultsContainer.innerHTML = html;
      if (window.lucide) window.lucide.createIcons();
    }

    // Type selector clicks
    document.querySelectorAll('#demoTypeSelector .demo-type-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#demoTypeSelector .demo-type-btn').forEach(b => {
          b.classList.remove('active', 'bg-blue-600', 'text-white', 'shadow');
          b.classList.add('text-slate-400');
        });
        btn.classList.add('active', 'bg-blue-600', 'text-white', 'shadow');
        btn.classList.remove('text-slate-400');
        currentType = btn.getAttribute('data-val');
        updateDemo();
      });
    });

    // Branch selector clicks
    document.querySelectorAll('#demoBranchSelector .demo-branch-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#demoBranchSelector .demo-branch-btn').forEach(b => {
          b.classList.remove('active', 'bg-blue-600', 'text-white', 'border-blue-500');
          b.classList.add('bg-slate-800', 'text-slate-300', 'border-slate-700');
        });
        btn.classList.add('active', 'bg-blue-600', 'text-white', 'border-blue-500');
        btn.classList.remove('bg-slate-800', 'text-slate-300', 'border-slate-700');
        currentBranch = btn.getAttribute('data-branch');
        updateDemo();
      });
    });

    // Slider input
    if (rankSlider) {
      rankSlider.addEventListener('input', (e) => {
        currentRank = parseInt(e.target.value, 10);
        updateDemo();
      });
    }

    // Initial render
    updateDemo();
  })();
</script>
