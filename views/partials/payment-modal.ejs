<!-- Payment Modal Component (Pankaj Kumar's Navi, PhonePe, Paytm QR & Admin Verification) -->
<div id="paymentModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md hidden" aria-modal="true" role="dialog">
  <div class="relative w-full max-w-lg bg-white rounded-3xl shadow-2xl border border-slate-200 overflow-hidden transform transition-all my-6 max-h-[94vh] flex flex-col">
    
    <!-- Modal Header -->
    <div class="px-6 py-4 bg-slate-900 text-white flex items-center justify-between shrink-0">
      <div class="flex items-center space-x-2.5">
        <div class="w-8 h-8 rounded-xl bg-blue-600/30 border border-blue-400/40 flex items-center justify-center text-blue-400">
          <i data-lucide="shield-check" class="w-4 h-4"></i>
        </div>
        <div>
          <h3 class="text-sm sm:text-base font-bold tracking-tight text-white leading-tight">Unlock Official Choice List</h3>
          <p class="text-[11px] text-slate-400">Direct UPI Payment • Admin Verified</p>
        </div>
      </div>
      <button type="button" id="closePaymentModalBtn" class="text-slate-400 hover:text-white transition p-1.5 rounded-xl hover:bg-slate-800">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <!-- Modal Scrollable Content -->
    <div class="p-5 sm:p-6 space-y-4 overflow-y-auto">
      
      <!-- Price Banner -->
      <div class="p-3.5 rounded-2xl bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-100 flex items-center justify-between shadow-xs">
        <div>
          <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">One-Time Download Fee</span>
          <div class="flex items-baseline space-x-1 mt-0.5">
            <span class="text-2xl sm:text-3xl font-black text-slate-900 font-mono">₹<%= paymentsConfig.pricePerDownloadInr || 49 %></span>
            <span class="text-xs text-slate-500 font-medium">only</span>
          </div>
        </div>
        <div class="text-right space-y-1">
          <span class="inline-block text-[10px] font-extrabold uppercase tracking-wider text-emerald-800 bg-emerald-100 border border-emerald-200 px-2.5 py-0.5 rounded-full">
            All 4 Formats Included
          </span>
          <span class="text-[11px] text-slate-600 font-medium block">PDF • Excel • Word • CSV</span>
        </div>
      </div>

      <!-- State 1: Payment Form (Select App, Scan QR & Enter UTR) -->
      <div id="paymentFormState" class="space-y-4">
        
        <!-- Step 1: Select App Tab -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold text-slate-900 uppercase tracking-wider flex items-center space-x-1.5">
              <span class="w-5 h-5 rounded-full bg-blue-600 text-white flex items-center justify-center text-[10px] font-bold">1</span>
              <span>Select Your Payment App</span>
            </span>
            <span class="text-[10px] text-slate-400">Scan or Tap to Pay</span>
          </div>

          <!-- App Tabs -->
          <div class="grid grid-cols-3 gap-2 text-xs font-bold">
            <!-- Navi Tab -->
            <button type="button" class="app-tab active p-2.5 rounded-2xl border-2 border-emerald-500 bg-emerald-50/80 text-emerald-950 flex flex-col items-center justify-center transition shadow-xs cursor-pointer" data-app="navi">
              <span class="text-xs font-black text-emerald-700">navi</span>
              <span class="text-[9px] font-medium text-emerald-800 mt-0.5">Navi / GPay</span>
            </button>

            <!-- PhonePe Tab -->
            <button type="button" class="app-tab p-2.5 rounded-2xl border border-slate-200 bg-slate-50 hover:bg-purple-50 text-slate-700 flex flex-col items-center justify-center transition cursor-pointer" data-app="phonepe">
              <span class="text-xs font-black text-purple-700">PhonePe</span>
              <span class="text-[9px] font-medium text-slate-500 mt-0.5">UPI / QR</span>
            </button>

            <!-- Paytm Tab -->
            <button type="button" class="app-tab p-2.5 rounded-2xl border border-slate-200 bg-slate-50 hover:bg-sky-50 text-slate-700 flex flex-col items-center justify-center transition cursor-pointer" data-app="paytm">
              <span class="text-xs font-black text-[#002e6e]">Paytm</span>
              <span class="text-[9px] font-medium text-slate-500 mt-0.5">Paytm UPI</span>
            </button>
          </div>
        </div>

        <!-- Dynamic QR & Pay Direct Section -->
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 text-center space-y-3">
          <div class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-[11px] font-bold border border-emerald-200">
            <i data-lucide="lock" class="w-3.5 h-3.5 text-emerald-600"></i>
            <span>Amount Auto-Filled &amp; Fixed at ₹<%= paymentsConfig.pricePerDownloadInr || 49 %></span>
          </div>

          <!-- QR Image Container -->
          <div class="relative block p-2 bg-white rounded-2xl border border-slate-200 shadow-sm max-w-[210px] mx-auto">
            <img id="activeQrImage" src="/images/qr-navi.png" alt="Pankaj Kumar UPI QR" class="w-48 h-auto max-h-56 rounded-xl mx-auto block object-contain">
            <span class="text-[10px] text-slate-400 block mt-1 font-mono font-bold">Auto-fills ₹49 on scan</span>
          </div>

          <!-- Details & Direct Pay Button -->
          <div class="space-y-2 max-w-sm mx-auto">
            <div class="flex items-center justify-between text-xs px-2 text-slate-600">
              <span>Payee: <strong id="payeeNameText" class="text-slate-900 font-bold"><%= paymentsConfig.upiPayeeName || 'Pankaj Kumar' %></strong></span>
              <span>Amount: <strong class="text-blue-600 font-bold">₹<%= paymentsConfig.pricePerDownloadInr || 49 %></strong></span>
            </div>

            <!-- UPI ID with Copy -->
            <div class="flex items-center space-x-1.5">
              <code id="activeUpiIdText" class="px-2.5 py-1.5 rounded-xl bg-white border border-slate-200 text-xs font-mono font-bold text-slate-800 flex-1 truncate select-all">8000859195@naviaxis</code>
              <button type="button" id="copyUpiBtn" class="px-3 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold transition shrink-0 flex items-center space-x-1 cursor-pointer">
                <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                <span id="copyUpiBtnText">Copy</span>
              </button>
            </div>

            <!-- Direct Mobile Intent Link -->
            <a id="directPayLink" href="upi://pay?pa=8000859195@naviaxis&pn=Pankaj%20Kumar&am=49&cu=INR&tn=PreJOSAA" class="block w-full py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-xs transition text-center">
              <i data-lucide="external-link" class="w-3.5 h-3.5 inline mr-1 -mt-0.5"></i>
              <span id="directPayText">Pay ₹49 on Navi / Installed UPI App</span>
            </a>
          </div>
        </div>

        <input type="hidden" id="paymentChoiceListId" value="">
        <input type="hidden" id="activeSelectedApp" value="navi">

        <!-- Step 2: Enter UPI UTR for Admin Verification -->
        <div class="space-y-2.5 pt-2 border-t border-slate-100">
          <label for="modalUpiUtrInput" class="text-xs font-bold text-slate-900 uppercase tracking-wider flex items-center justify-between">
            <span class="flex items-center space-x-1.5">
              <span class="w-5 h-5 rounded-full bg-blue-600 text-white flex items-center justify-center text-[10px] font-bold">2</span>
              <span>Enter 12-Digit UPI UTR / Ref No.</span>
            </span>
            <span class="text-[10px] text-slate-400 font-normal lowercase">(from transaction receipt)</span>
          </label>

          <input type="text" id="modalUpiUtrInput" placeholder="e.g. 428909871234 or Bank UTR" maxlength="30" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-100 text-sm font-mono tracking-wider text-slate-900 placeholder:text-slate-400 placeholder:font-sans uppercase">

          <div id="paymentErrorMsg" class="hidden text-xs text-rose-700 bg-rose-50 border border-rose-200 p-3 rounded-xl"></div>

          <!-- Submit for Admin Verification Button -->
          <button type="button" id="modalSubmitUpiBtn" class="w-full py-3.5 rounded-xl bg-blue-600 hover:bg-blue-700 active:scale-[0.99] text-white font-bold text-sm shadow-md shadow-blue-500/20 transition flex items-center justify-center space-x-2 cursor-pointer">
            <i data-lucide="send" class="w-4 h-4"></i>
            <span id="modalUpiSubmitText">Submit UTR for Admin Verification</span>
          </button>
        </div>

        <div class="text-center text-[10px] text-slate-400 flex items-center justify-center space-x-1">
          <i data-lucide="shield" class="w-3 h-3 text-slate-400"></i>
          <span>Secure direct account transfer • Admin verifies every payment at portal</span>
        </div>
      </div>

      <!-- State 2: Under Admin Review / Pending State -->
      <div id="paymentPendingState" class="space-y-4 text-center py-6 hidden">
        <div class="w-16 h-16 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center mx-auto shadow-inner">
          <i data-lucide="clock" class="w-9 h-9 animate-pulse"></i>
        </div>
        <div class="space-y-1">
          <h4 class="text-lg font-bold text-slate-900">Payment Submitted for Verification</h4>
          <p class="text-xs text-slate-500 max-w-sm mx-auto leading-relaxed">
            Your UPI reference number has been received. Our admin team will verify the payment in the admin portal. Once confirmed, your downloads will unlock automatically.
          </p>
        </div>

        <div class="p-3 bg-slate-50 rounded-2xl border border-slate-200 text-xs font-mono text-slate-700 max-w-sm mx-auto">
          <span>Submitted UTR: </span>
          <strong id="pendingUtrDisplay" class="text-slate-900 font-bold"></strong>
        </div>

        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-2">
          <button type="button" id="btnCheckApprovalStatus" class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-xs transition flex items-center justify-center space-x-1.5 cursor-pointer">
            <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
            <span>Check Verification Status</span>
          </button>
          <button type="button" id="btnReenterUtr" class="w-full sm:w-auto px-4 py-2.5 rounded-xl border border-slate-300 text-slate-600 hover:bg-slate-100 text-xs font-semibold transition cursor-pointer">
            Re-enter UTR
          </button>
        </div>
      </div>

      <!-- State 3: Approved / Unlocked State -->
      <div id="paymentApprovedState" class="space-y-5 text-center py-4 hidden">
        <div class="w-16 h-16 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto shadow-inner">
          <i data-lucide="check-circle-2" class="w-10 h-10"></i>
        </div>
        <div>
          <h4 class="text-xl font-extrabold text-slate-900">Payment Verified &amp; Unlocked!</h4>
          <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">Admin has approved your payment. Your JoSAA choice list is ready in all 4 formats:</p>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs font-bold pt-2">
          <a id="modalDownloadPdf" href="#" class="p-3.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white flex items-center justify-center space-x-2 shadow-sm transition">
            <i data-lucide="file-text" class="w-4 h-4"></i>
            <span>Download PDF</span>
          </a>
          <a id="modalDownloadXlsx" href="#" class="p-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white flex items-center justify-center space-x-2 shadow-sm transition">
            <i data-lucide="table" class="w-4 h-4"></i>
            <span>Download Excel</span>
          </a>
          <a id="modalDownloadDocx" href="#" class="p-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white flex items-center justify-center space-x-2 shadow-sm transition">
            <i data-lucide="file" class="w-4 h-4"></i>
            <span>Download Word</span>
          </a>
          <a id="modalDownloadCsv" href="#" class="p-3.5 rounded-xl bg-slate-800 hover:bg-slate-900 text-white flex items-center justify-center space-x-2 shadow-sm transition">
            <i data-lucide="code" class="w-4 h-4"></i>
            <span>Download CSV</span>
          </a>
        </div>

        <div class="pt-2">
          <button type="button" id="modalCloseAfterUnlockBtn" class="text-xs text-slate-500 hover:text-slate-800 underline">
            Close and return to Choice Editor
          </button>
        </div>
      </div>

    </div>
  </div>
</div>
