<!-- Header / Navigation Bar -->
<header class="sticky top-0 z-40 glass-header">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-18">
      
      <!-- Brand Logo (PreJOSAA) -->
      <a href="/" class="flex items-center space-x-3 group py-1">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-700 via-blue-600 to-sky-500 flex items-center justify-center text-white shadow-md shadow-blue-500/20 group-hover:shadow-blue-500/35 group-hover:scale-105 transition duration-200">
          <i data-lucide="compass" class="w-5 h-5 stroke-[2.2]"></i>
        </div>
        <div class="flex flex-col">
          <span class="text-xl font-extrabold tracking-tight text-slate-900 group-hover:text-blue-600 transition duration-150">
            Pre<span class="text-blue-600">JOSAA</span>
          </span>
        </div>
      </a>

      <!-- Desktop Nav with Active Indicators -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-1.5" id="desktopNav">
        <a href="/generator" data-path="/generator" class="nav-link px-3.5 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:text-blue-700 hover:bg-slate-100/70 transition flex items-center space-x-2">
          <i data-lucide="list-ordered" class="w-4 h-4 text-slate-400 nav-icon"></i>
          <span>Choice Generator</span>
        </a>
        <a href="/explore" data-path="/explore" class="nav-link px-3.5 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:text-blue-700 hover:bg-slate-100/70 transition flex items-center space-x-2">
          <i data-lucide="search" class="w-4 h-4 text-slate-400 nav-icon"></i>
          <span>College Explorer</span>
        </a>
        <a href="/nirf" data-path="/nirf" class="nav-link px-3.5 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:text-blue-700 hover:bg-slate-100/70 transition flex items-center space-x-2">
          <i data-lucide="award" class="w-4 h-4 text-slate-400 nav-icon"></i>
          <span>NIRF Rankings</span>
        </a>
        <a href="/branches" data-path="/branches" class="nav-link px-3.5 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:text-blue-700 hover:bg-slate-100/70 transition flex items-center space-x-2">
          <i data-lucide="git-branch" class="w-4 h-4 text-slate-400 nav-icon"></i>
          <span>Branches</span>
        </a>
        <a href="/about" data-path="/about" class="nav-link px-3.5 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:text-blue-700 hover:bg-slate-100/70 transition flex items-center space-x-2">
          <i data-lucide="shield-check" class="w-4 h-4 text-slate-400 nav-icon"></i>
          <span>Data Sources</span>
        </a>
      </nav>

      <!-- Right Action Area: Profile / Login + Primary CTA -->
      <div class="flex items-center space-x-3">
        <% if (user) { %>
          <div class="relative group">
            <button class="flex items-center space-x-2.5 px-3 py-1.5 rounded-xl border border-slate-200/90 bg-white hover:bg-slate-50 text-xs font-semibold text-slate-800 shadow-sm transition">
              <div class="w-6 h-6 rounded-lg bg-blue-100 text-blue-700 font-bold flex items-center justify-center text-[11px]">
                <%= user.name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() %>
              </div>
              <span class="max-w-[120px] truncate"><%= user.name %></span>
              <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-400 group-hover:rotate-180 transition duration-200"></i>
            </button>
            <div class="absolute right-0 mt-2 w-52 bg-white rounded-2xl shadow-xl border border-slate-100 py-1.5 hidden group-hover:block z-50 animate-in fade-in slide-in-from-top-2 duration-150">
              <div class="px-4 py-2 border-b border-slate-100">
                <span class="text-xs font-bold text-slate-900 block"><%= user.name %></span>
                <span class="text-[10px] text-slate-400 font-mono block truncate"><%= user.email %></span>
              </div>
              <a href="/generator" class="flex items-center space-x-2 px-4 py-2 text-xs font-medium text-slate-700 hover:bg-blue-50 hover:text-blue-700 transition">
                <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
                <span>Create New Choice List</span>
              </a>
              <a href="/logout" class="flex items-center space-x-2 px-4 py-2 text-xs font-medium text-rose-600 hover:bg-rose-50 transition border-t border-slate-50">
                <i data-lucide="log-out" class="w-3.5 h-3.5"></i>
                <span>Log Out</span>
              </a>
            </div>
          </div>
        <% } else { %>
          <a href="/login" class="text-xs font-semibold text-slate-600 hover:text-blue-700 px-3 py-2 transition">
            Sign In
          </a>
        <% } %>

        <a href="/generator" class="hidden sm:inline-flex items-center justify-center px-4 py-2 rounded-xl text-xs font-bold btn-primary">
          <span>Create Choice List</span>
          <i data-lucide="arrow-right" class="w-3.5 h-3.5 ml-1.5"></i>
        </a>

        <!-- Mobile Navigation Trigger -->
        <button id="mobileMenuBtn" class="md:hidden p-2 rounded-xl text-slate-600 hover:bg-slate-100 transition focus:outline-none" aria-label="Toggle Navigation">
          <i data-lucide="menu" class="w-5 h-5"></i>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu Drawer / Dropdown -->
  <div id="mobileMenu" class="hidden md:hidden border-t border-slate-200 bg-white/95 backdrop-blur-md px-4 pt-3 pb-5 space-y-1">
    <a href="/generator" class="flex items-center space-x-2 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-700">
      <i data-lucide="list-ordered" class="w-4 h-4 text-blue-600"></i>
      <span>Choice Generator</span>
    </a>
    <a href="/explore" class="flex items-center space-x-2 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-700">
      <i data-lucide="search" class="w-4 h-4 text-slate-400"></i>
      <span>College Explorer</span>
    </a>
    <a href="/nirf" class="flex items-center space-x-2 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-700">
      <i data-lucide="award" class="w-4 h-4 text-slate-400"></i>
      <span>NIRF Rankings</span>
    </a>
    <a href="/branches" class="flex items-center space-x-2 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-700">
      <i data-lucide="git-branch" class="w-4 h-4 text-slate-400"></i>
      <span>Branches</span>
    </a>
    <a href="/about" class="flex items-center space-x-2 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-700">
      <i data-lucide="shield-check" class="w-4 h-4 text-slate-400"></i>
      <span>Data Sources</span>
    </a>

    <% if (user) { %>
      <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
        <span class="text-xs font-semibold text-slate-600"><%= user.name %></span>
        <a href="/logout" class="text-xs font-bold text-rose-600 hover:underline">Log Out</a>
      </div>
    <% } else { %>
      <div class="pt-3 border-t border-slate-100 flex space-x-2">
        <a href="/login" class="flex-1 text-center py-2 px-3 border border-slate-300 rounded-xl text-xs font-semibold text-slate-700">Sign In</a>
        <a href="/signup" class="flex-1 text-center py-2 px-3 btn-primary rounded-xl text-xs font-bold">Sign Up</a>
      </div>
    <% } %>
  </div>
</header>

<!-- Active link script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const currentPath = window.location.pathname;
    const navLinks = document.querySelectorAll('#desktopNav .nav-link');
    navLinks.forEach(link => {
      const path = link.getAttribute('data-path');
      if (currentPath === path || (path !== '/' && currentPath.startsWith(path))) {
        link.className = 'nav-link px-3.5 py-2 rounded-xl text-xs font-bold bg-blue-50 text-blue-700 shadow-xs flex items-center space-x-2';
        const icon = link.querySelector('.nav-icon');
        if (icon) icon.className = 'w-4 h-4 text-blue-600 nav-icon';
      }
    });
  });
</script>
