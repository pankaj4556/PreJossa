<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %>PreJOSAA — JoSAA Choice Filling & College Explorer</title>
  <meta name="description" content="PreJOSAA helps JEE Main & Advanced students prepare their official JoSAA choice filling sequence in minutes with verified cutoffs, NIRF rankings, and placement statistics for 23 IITs and 31 NITs.">
  <meta name="theme-color" content="#2563eb">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="shortcut icon" href="/favicon.ico">

  <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'system-ui', '-apple-system', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace']
          },
          colors: {
            brand: {
              50: '#eff6ff',
              100: '#dbeafe',
              200: '#bfdbfe',
              300: '#93c5fd',
              400: '#60a5fa',
              500: '#3b82f6',
              600: '#2563eb',
              700: '#1d4ed8',
              800: '#1e40af',
              900: '#1e3a8a',
              950: '#172554'
            },
            navy: {
              800: '#1e293b',
              900: '#0f172a',
              950: '#070d1e'
            }
          },
          boxShadow: {
            'card-lift': '0 12px 30px -8px rgba(15, 23, 42, 0.08), 0 4px 12px -2px rgba(15, 23, 42, 0.03)',
            'brand-glow': '0 4px 20px -2px rgba(37, 99, 235, 0.25)',
          }
        }
      }
    }
  </script>

  <!-- PreJOSAA Main Design System Stylesheet -->
  <link rel="stylesheet" href="/css/main.css">

  <!-- Scroll-Reveal Utility (Intersection Observer, shared across all pages) -->
  <script src="/js/scroll-reveal.js" defer></script>

  <!-- Lucide Minimal Line Icons (Zero Emojis per PRD Section 5) -->
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 selection:bg-blue-600 selection:text-white antialiased">
