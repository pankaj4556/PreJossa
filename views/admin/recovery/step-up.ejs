<%- include('../../partials/head', { title: 'Admin Step-Up Authentication' }) %>

<div class="min-h-screen bg-slate-950 flex items-center justify-center p-4">
  <div class="max-w-md w-full rounded-2xl bg-slate-900 border border-slate-800 shadow-2xl p-6 sm:p-8 space-y-6">
    
    <div class="text-center space-y-2">
      <div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center mx-auto text-amber-400 shadow-lg shadow-amber-950/50">
        <i data-lucide="shield-alert" class="w-6 h-6"></i>
      </div>
      <h1 class="text-xl font-extrabold text-white tracking-tight">Step-Up Authentication</h1>
      <p class="text-xs text-slate-400">
        Zero Trust Security policy requires elevated password verification before executing privileged recovery, rollback, containment, or export actions.
      </p>
    </div>

    <% if (error) { %>
      <div class="p-3.5 rounded-xl bg-red-950/80 border border-red-700/60 text-xs text-red-200 flex items-center space-x-2">
        <i data-lucide="alert-circle" class="w-4 h-4 flex-shrink-0"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <form method="POST" action="<%= recoveryRoutePath %>/step-up" class="space-y-4">
      <input type="hidden" name="returnTo" value="<%= returnTo %>">

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1.5">Administrator Password</label>
        <input 
          type="password" 
          name="password" 
          required 
          autofocus
          placeholder="Enter your admin password"
          class="w-full px-4 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-white placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 transition"
        >
      </div>

      <div class="text-[11px] text-slate-400 flex items-center space-x-1.5">
        <i data-lucide="clock" class="w-3.5 h-3.5 text-amber-400"></i>
        <span>Clearance token remains active for <strong>5 minutes</strong>.</span>
      </div>

      <div class="pt-2 flex items-center space-x-3">
        <a href="<%= adminRoutePath %>" class="w-1/2 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold text-center transition">
          Cancel
        </a>
        <button type="submit" class="w-1/2 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-500 text-white text-xs font-bold transition shadow-lg shadow-amber-950/50">
          Verify Clearance
        </button>
      </div>
    </form>

  </div>
</div>

<script>
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
</script>
<%- include('../../partials/footer') %>
