<%- include('../../partials/head', { title: 'Recovery Center — Resilience & Continuity' }) %>

<div class="min-h-screen bg-slate-900 text-white flex flex-col">
  <%- include('./nav', { activeTab: 'overview' }) %>

  <main class="flex-1 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    
    <!-- Top Action / Status Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center space-x-2">
          <h1 class="text-2xl font-bold tracking-tight">Recovery Center</h1>
          <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold tracking-wide uppercase bg-emerald-500/10 border border-emerald-500/30 text-emerald-400">
            Immutable SQLite &bull; Zero Trust
          </span>
        </div>
        <p class="text-xs text-slate-400 mt-1">High-availability disaster recovery, automated recovery point validation, RPO/RTO SLAs, and staging drills.</p>
      </div>

      <div class="flex items-center space-x-2.5 flex-wrap gap-y-2">
        <!-- Create Backup Button -->
        <form method="POST" action="<%= recoveryRoutePath %>/backups/create" class="inline">
          <button type="submit" class="px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-xs font-bold transition flex items-center space-x-1.5 shadow-md shadow-emerald-950/40">
            <i data-lucide="plus-circle" class="w-4 h-4"></i>
            <span>Create Clean Backup</span>
          </button>
        </form>

        <!-- Run Drill Button -->
        <form method="POST" action="<%= recoveryRoutePath %>/drills/run" class="inline">
          <button type="submit" class="px-3.5 py-2 rounded-xl bg-sky-600 hover:bg-sky-500 text-xs font-bold transition flex items-center space-x-1.5 shadow-md shadow-sky-950/40">
            <i data-lucide="play" class="w-4 h-4"></i>
            <span>Run Restore Drill</span>
          </button>
        </form>

        <!-- Restore to Staging Button -->
        <form method="POST" action="<%= recoveryRoutePath %>/staging/run" class="inline">
          <button type="submit" class="px-3.5 py-2 rounded-xl bg-purple-600 hover:bg-purple-500 text-xs font-bold transition flex items-center space-x-1.5 shadow-md shadow-purple-950/40">
            <i data-lucide="layers" class="w-4 h-4"></i>
            <span>Restore to Staging</span>
          </button>
        </form>
      </div>
    </div>

    <!-- Notification / Flash -->
    <% if (flash) { %>
      <div class="p-4 rounded-xl text-xs font-medium flex items-center space-x-2 <%= flashType === 'success' ? 'bg-emerald-950/80 border border-emerald-700/60 text-emerald-200' : (flashType === 'error' ? 'bg-red-950/80 border border-red-700/60 text-red-200' : 'bg-sky-950/80 border border-sky-700/60 text-sky-200') %>">
        <i data-lucide="<%= flashType === 'success' ? 'check-circle' : (flashType === 'error' ? 'alert-octagon' : 'info') %>" class="w-4 h-4 flex-shrink-0"></i>
        <span><%= flash %></span>
      </div>
    <% } %>

    <!-- Resilience Metrics Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
      
      <!-- RPO Metric Card -->
      <div class="p-5 rounded-2xl bg-slate-800 border border-slate-700/80 space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-slate-400 uppercase tracking-wider text-[10px] font-bold">RPO Status (Data Loss Risk)</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold <%= stats.rpo.status === 'HEALTHY' ? 'bg-emerald-950 border border-emerald-700 text-emerald-400' : (stats.rpo.status === 'AT_RISK' ? 'bg-amber-950 border border-amber-700 text-amber-400' : 'bg-red-950 border border-red-700 text-red-400') %>">
            <%= stats.rpo.status %>
          </span>
        </div>
        <div class="flex items-baseline space-x-2">
          <div class="text-3xl font-extrabold text-white font-mono">
            <%= stats.rpo.actualMinutes !== null ? stats.rpo.actualMinutes + 'm' : 'N/A' %>
          </div>
          <span class="text-slate-400 text-[11px]">/ Target &lt; <%= stats.sla.targetRpoMinutes / 60 %>h</span>
        </div>
        <p class="text-[11px] text-slate-400">
          Last validated clean point: <strong class="text-slate-200"><%= stats.rpo.lastBackupTime || 'None' %></strong>
        </p>
      </div>

      <!-- RTO Metric Card -->
      <div class="p-5 rounded-2xl bg-slate-800 border border-slate-700/80 space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-slate-400 uppercase tracking-wider text-[10px] font-bold">Measured RTO (Recovery Time)</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold <%= stats.rto.status === 'EXCELLING' ? 'bg-emerald-950 border border-emerald-700 text-emerald-400' : 'bg-slate-700 text-slate-300' %>">
            <%= stats.rto.status %>
          </span>
        </div>
        <div class="flex items-baseline space-x-2">
          <div class="text-3xl font-extrabold text-emerald-400 font-mono">
            <%= stats.rto.measuredSeconds !== null ? stats.rto.measuredSeconds + 's' : 'Drill Needed' %>
          </div>
          <span class="text-slate-400 text-[11px]">/ SLA Target &lt; <%= stats.sla.targetRtoMinutes %>m</span>
        </div>
        <p class="text-[11px] text-slate-400">
          Benchmark from isolated sandbox drill execution.
        </p>
      </div>

      <!-- Staging Instance Card -->
      <div class="p-5 rounded-2xl bg-slate-800 border border-slate-700/80 space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-slate-400 uppercase tracking-wider text-[10px] font-bold">Staging Health</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold <%= stats.staging ? 'bg-purple-950 border border-purple-700 text-purple-300' : 'bg-slate-700 text-slate-400' %>">
            <%= stats.staging ? 'READY' : 'NOT INITIALIZED' %>
          </span>
        </div>
        <div class="text-2xl font-extrabold text-purple-300 font-mono truncate">
          <%= stats.staging ? (stats.staging.sizeBytes / 1024 / 1024).toFixed(2) + ' MB' : '0 MB' %>
        </div>
        <p class="text-[11px] text-slate-400 truncate">
          <%= stats.staging ? 'Active: database/staging.sqlite' : 'Click "Restore to Staging" to spin up instance' %>
        </p>
      </div>

      <!-- Threat Level Card -->
      <div class="p-5 rounded-2xl bg-slate-800 border border-slate-700/80 space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-slate-400 uppercase tracking-wider text-[10px] font-bold">Threat Level (15m)</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold <%= threats.threatLevel === 'NORMAL' ? 'bg-emerald-950 border border-emerald-700 text-emerald-400' : (threats.threatLevel === 'ELEVATED' ? 'bg-amber-950 border border-amber-700 text-amber-400' : 'bg-red-950 border border-red-700 text-red-400') %>">
            <%= threats.threatLevel %>
          </span>
        </div>
        <div class="text-3xl font-extrabold font-mono <%= threats.threatLevel === 'NORMAL' ? 'text-white' : 'text-amber-400' %>">
          Score: <%= threats.threatScore %>/100
        </div>
        <p class="text-[11px] text-slate-400">
          <%= threats.containment.enabled ? 'Containment Mode LOCKED' : 'Zero mass anomalies detected' %>
        </p>
      </div>

    </div>

    <!-- Last Known Good Card -->
    <div class="p-6 rounded-2xl bg-gradient-to-r from-slate-800 via-slate-800/90 to-emerald-950/30 border border-emerald-500/30 shadow-xl space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/40 flex items-center justify-center text-emerald-400">
            <i data-lucide="award" class="w-5 h-5"></i>
          </div>
          <div>
            <div class="flex items-center space-x-2">
              <h2 class="text-base font-bold text-white">Last Known Good Recovery Point</h2>
              <span class="px-2 py-0.5 rounded bg-emerald-950 border border-emerald-700 text-emerald-300 text-[10px] font-bold tracking-wider uppercase">
                VALIDATED CLEAN
              </span>
            </div>
            <p class="text-xs text-slate-400 mt-0.5">Automated validation passed: PRAGMA integrity_check OK &bull; 0 Foreign Key violations &bull; Valid row counts</p>
          </div>
        </div>

        <% if (stats.lastKnownGood) { %>
          <div class="flex items-center space-x-2">
            <form method="POST" action="<%= recoveryRoutePath %>/drills/run" class="inline">
              <input type="hidden" name="backupId" value="<%= stats.lastKnownGood.id %>">
              <button type="submit" class="px-3 py-1.5 rounded-lg bg-slate-700 hover:bg-slate-600 text-xs font-semibold text-slate-200 transition flex items-center space-x-1">
                <i data-lucide="play" class="w-3.5 h-3.5"></i>
                <span>Test Drill</span>
              </button>
            </form>
            <form method="POST" action="<%= recoveryRoutePath %>/staging/run" class="inline">
              <input type="hidden" name="backupId" value="<%= stats.lastKnownGood.id %>">
              <button type="submit" class="px-3 py-1.5 rounded-lg bg-purple-900/60 border border-purple-700 text-xs font-semibold text-purple-200 hover:bg-purple-800/60 transition flex items-center space-x-1">
                <i data-lucide="layers" class="w-3.5 h-3.5"></i>
                <span>Deploy to Staging</span>
              </button>
            </form>
          </div>
        <% } %>
      </div>

      <% if (stats.lastKnownGood) { %>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-3 border-t border-slate-700/60 text-xs">
          <div>
            <span class="text-slate-400 text-[11px] block">Backup Filename</span>
            <span class="font-mono text-slate-200 text-xs font-medium"><%= stats.lastKnownGood.filename %></span>
          </div>
          <div>
            <span class="text-slate-400 text-[11px] block">SHA-256 Checksum</span>
            <span class="font-mono text-emerald-400 text-xs font-medium truncate block max-w-xs" title="<%= stats.lastKnownGood.sha256_checksum %>">
              <%= stats.lastKnownGood.sha256_checksum %>
            </span>
          </div>
          <div>
            <span class="text-slate-400 text-[11px] block">Creation &amp; Validation Timestamp</span>
            <span class="text-slate-200 text-xs"><%= stats.lastKnownGood.created_at %></span>
          </div>
        </div>
      <% } else { %>
        <div class="text-xs text-slate-400 py-2">
          No validated clean recovery point registered yet. Click <strong>"Create Clean Backup"</strong> above to generate your first validated recovery point.
        </div>
      <% } %>
    </div>

    <!-- Two Column Grid: Backups & Recent Drills -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Backups Table (2 cols) -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <h2 class="text-base font-bold tracking-tight">Recovery Point Catalog</h2>
            <span class="text-xs text-slate-400">(<%= stats.backups.length %> points)</span>
          </div>
          <a href="<%= recoveryRoutePath %>/backups" class="text-xs text-emerald-400 hover:text-emerald-300 font-semibold flex items-center space-x-1">
            <span>View All &rarr;</span>
          </a>
        </div>

        <div class="rounded-2xl bg-slate-800 border border-slate-700/80 overflow-hidden shadow-lg">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-slate-900/80 border-b border-slate-700/80 text-slate-400 font-semibold uppercase tracking-wider text-[10px]">
                <tr>
                  <th class="px-4 py-3">Point / Time</th>
                  <th class="px-4 py-3">Validation Status</th>
                  <th class="px-4 py-3">Size &bull; SHA-256</th>
                  <th class="px-4 py-3 text-right">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-700/50">
                <% if (stats.backups.length === 0) { %>
                  <tr>
                    <td colspan="4" class="px-4 py-6 text-center text-slate-400">No backups found. Click "Create Clean Backup" to create one.</td>
                  </tr>
                <% } %>
                <% stats.backups.slice(0, 5).forEach(b => { %>
                  <tr class="hover:bg-slate-700/30 transition">
                    <td class="px-4 py-3">
                      <div class="font-medium text-slate-200"><%= b.filename %></div>
                      <div class="text-[11px] text-slate-400 font-mono"><%= b.created_at %></div>
                    </td>
                    <td class="px-4 py-3">
                      <% if (b.status === 'validated_clean') { %>
                        <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-950 border border-emerald-700/80 text-emerald-400">
                          <i data-lucide="check" class="w-3 h-3"></i>
                          <span>Validated Clean</span>
                        </span>
                      <% } else { %>
                        <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[10px] font-bold bg-red-950 border border-red-700/80 text-red-400">
                          <i data-lucide="x" class="w-3 h-3"></i>
                          <span><%= b.status %></span>
                        </span>
                      <% } %>
                      <% if (b.is_last_known_good) { %>
                        <span class="ml-1 inline-flex items-center px-1.5 py-0.2 rounded text-[9px] font-bold bg-amber-950 border border-amber-700 text-amber-300">
                          LKG
                        </span>
                      <% } %>
                    </td>
                    <td class="px-4 py-3 text-slate-300 font-mono text-[11px]">
                      <div><%= (b.filesize_bytes / 1024 / 1024).toFixed(2) %> MB</div>
                      <div class="text-slate-400 truncate max-w-[120px]" title="<%= b.sha256_checksum %>">
                        <%= b.sha256_checksum ? b.sha256_checksum.slice(0, 14) + '...' : 'none' %>
                      </div>
                    </td>
                    <td class="px-4 py-3 text-right whitespace-nowrap">
                      <div class="flex items-center justify-end space-x-1.5">
                        <form method="POST" action="<%= recoveryRoutePath %>/drills/run" class="inline">
                          <input type="hidden" name="backupId" value="<%= b.id %>">
                          <button type="submit" class="p-1.5 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs" title="Run Sandbox Drill">
                            <i data-lucide="play" class="w-3.5 h-3.5"></i>
                          </button>
                        </form>
                        <form method="POST" action="<%= recoveryRoutePath %>/staging/run" class="inline">
                          <input type="hidden" name="backupId" value="<%= b.id %>">
                          <button type="submit" class="p-1.5 rounded-lg bg-purple-900/60 hover:bg-purple-800 text-purple-200 text-xs" title="Restore to Staging">
                            <i data-lucide="layers" class="w-3.5 h-3.5"></i>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Right Column: Recent Drills & Threat Summary (1 col) -->
      <div class="space-y-6">
        
        <!-- Recent Restore Drills Card -->
        <div class="p-5 rounded-2xl bg-slate-800 border border-slate-700/80 space-y-3 shadow-lg">
          <div class="flex items-center justify-between">
            <h3 class="text-sm font-bold text-white flex items-center space-x-1.5">
              <i data-lucide="timer" class="w-4 h-4 text-emerald-400"></i>
              <span>Recent Restore Drills</span>
            </h3>
            <a href="<%= recoveryRoutePath %>/drills" class="text-[11px] text-emerald-400 hover:underline">All Drills &rarr;</a>
          </div>

          <div class="space-y-2.5">
            <% if (stats.recentDrills.length === 0) { %>
              <p class="text-xs text-slate-400 py-3 text-center">No restore drills executed yet.</p>
            <% } %>
            <% stats.recentDrills.slice(0, 4).forEach(d => { %>
              <div class="p-3 rounded-xl bg-slate-900/70 border border-slate-700/60 text-xs flex items-center justify-between">
                <div>
                  <div class="font-medium text-slate-200 flex items-center space-x-1">
                    <span class="w-2 h-2 rounded-full <%= d.status === 'PASSED' ? 'bg-emerald-400' : 'bg-red-400' %>"></span>
                    <span class="font-semibold"><%= d.drill_type %></span>
                  </div>
                  <span class="text-[10px] text-slate-400"><%= d.executed_at %> &bull; by <%= d.executed_by %></span>
                </div>
                <div class="text-right">
                  <span class="font-mono text-emerald-400 font-bold"><%= d.rto_seconds %>s</span>
                  <span class="block text-[9px] text-slate-400">RTO</span>
                </div>
              </div>
            <% }) %>
          </div>
        </div>

        <!-- Zero Trust Quick Reference Card -->
        <div class="p-5 rounded-2xl bg-slate-800/80 border border-slate-700/80 space-y-3">
          <h3 class="text-sm font-bold text-white flex items-center space-x-1.5">
            <i data-lucide="lock" class="w-4 h-4 text-sky-400"></i>
            <span>Zero Trust &amp; Immobility</span>
          </h3>
          <ul class="space-y-2 text-xs text-slate-300">
            <li class="flex items-start space-x-2">
              <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-400 mt-0.5 flex-shrink-0"></i>
              <span><strong>Soft Deletes:</strong> Records retain <code class="text-[11px] bg-slate-900 px-1 py-0.5 rounded text-sky-300">is_deleted=1</code>; no raw deletes.</span>
            </li>
            <li class="flex items-start space-x-2">
              <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-400 mt-0.5 flex-shrink-0"></i>
              <span><strong>Append-Only Audit:</strong> Every sensitive action logged to <code class="text-[11px] bg-slate-900 px-1 py-0.5 rounded text-sky-300">audit_logs</code>.</span>
            </li>
            <li class="flex items-start space-x-2">
              <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-400 mt-0.5 flex-shrink-0"></i>
              <span><strong>Step-Up Auth:</strong> Restores &amp; mass exports require 5-min step-up token.</span>
            </li>
          </ul>
        </div>

      </div>

    </div>

  </main>
</div>

<script>
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
</script>
<%- include('../../partials/footer') %>
