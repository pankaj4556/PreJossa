<%- include('../../partials/head', { title: 'Ransomware Scenario — Technical Interview Evidence' }) %>

<div class="min-h-screen bg-slate-900 text-white flex flex-col">
  <%- include('./nav', { activeTab: 'ransomware' }) %>

  <main class="flex-1 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center space-x-2">
          <h1 class="text-2xl font-bold tracking-tight">Ransomware Scenario: Technical Interview Evidence</h1>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-purple-950 border border-purple-700 text-purple-300">
            Field Test Simulation
          </span>
        </div>
        <p class="text-xs text-slate-400 mt-1">
          Complete end-to-end evidence demonstrating database corruption detection, emergency containment, Last Known Good rollback, and staging verification.
        </p>
      </div>

      <div>
        <form method="POST" action="<%= recoveryRoutePath %>/ransomware-scenario/simulate">
          <button type="submit" class="px-4 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-xs font-bold transition flex items-center space-x-2 shadow-lg shadow-purple-950/50">
            <i data-lucide="play" class="w-4 h-4"></i>
            <span>Run Live Simulation Drill</span>
          </button>
        </form>
      </div>
    </div>

    <!-- Simulation Output (If executed) -->
    <% if (simulationResult) { %>
      <div class="p-6 rounded-2xl bg-gradient-to-r from-slate-800 via-slate-800 to-purple-950/50 border border-purple-500/40 shadow-2xl space-y-5 animate-in fade-in">
        <div class="flex items-center justify-between border-b border-slate-700/80 pb-3">
          <div class="flex items-center space-x-2">
            <i data-lucide="check-circle" class="w-5 h-5 text-emerald-400"></i>
            <h2 class="text-base font-bold text-white">Simulation Execution Evidence Report</h2>
          </div>
          <span class="px-2.5 py-1 rounded-full text-xs font-mono font-bold bg-emerald-950 border border-emerald-700 text-emerald-300">
            VERDICT: <%= simulationResult.step4_verdict || 'RECOVERY_VALIDATED' %>
          </span>
        </div>

        <!-- 4 Step Proof Grid -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 text-xs">
          <!-- Step 1 -->
          <div class="p-4 rounded-xl bg-slate-900/70 border border-slate-800 space-y-1.5">
            <span class="text-purple-400 text-[10px] uppercase font-bold block">Step 1: Baseline Clean Point</span>
            <div class="font-bold text-slate-200">Point Verified</div>
            <p class="text-[11px] text-slate-400 font-mono truncate"><%= simulationResult.step1_clean_point.filename %></p>
            <span class="inline-block px-2 py-0.5 rounded text-[9px] font-bold bg-emerald-950 text-emerald-400">
              <%= simulationResult.step1_clean_point.status %>
            </span>
          </div>

          <!-- Step 2 -->
          <div class="p-4 rounded-xl bg-slate-900/70 border border-slate-800 space-y-1.5">
            <span class="text-red-400 text-[10px] uppercase font-bold block">Step 2: Corruption Injected</span>
            <div class="font-bold text-slate-200">Anomaly Caught</div>
            <p class="text-[11px] text-slate-400">Integrity check: <strong class="text-red-400"><%= simulationResult.step2_corruption_simulation.corruptedCheck %></strong></p>
            <span class="inline-block px-2 py-0.5 rounded text-[9px] font-bold bg-red-950 text-red-400">
              CORRUPTION DETECTED
            </span>
          </div>

          <!-- Step 3 -->
          <div class="p-4 rounded-xl bg-slate-900/70 border border-slate-800 space-y-1.5">
            <span class="text-sky-400 text-[10px] uppercase font-bold block">Step 3: Clean Restore</span>
            <div class="font-bold text-slate-200">Point-in-Time Cutover</div>
            <p class="text-[11px] text-slate-400">Empirical RTO: <strong class="text-emerald-400 font-mono"><%= simulationResult.step3_clean_restore.measuredRTO %></strong></p>
            <span class="inline-block px-2 py-0.5 rounded text-[9px] font-bold bg-sky-950 text-sky-400">
              DRILL <%= simulationResult.step3_clean_restore.drillStatus %>
            </span>
          </div>

          <!-- Step 4 -->
          <div class="p-4 rounded-xl bg-slate-900/70 border border-slate-800 space-y-1.5">
            <span class="text-emerald-400 text-[10px] uppercase font-bold block">Step 4: Health Verified</span>
            <div class="font-bold text-slate-200">Zero Data Loss</div>
            <p class="text-[11px] text-slate-400">Integrity status: <strong class="text-emerald-400">OK</strong></p>
            <span class="inline-block px-2 py-0.5 rounded text-[9px] font-bold bg-emerald-950 text-emerald-400">
              100% HEALTHY
            </span>
          </div>
        </div>

      </div>
    <% } %>

    <!-- Interactive Architecture Guide for Interviewers -->
    <div class="rounded-2xl bg-slate-800 border border-slate-700/80 p-6 space-y-6 text-xs text-slate-300">
      
      <div class="border-b border-slate-700 pb-3">
        <h2 class="text-base font-bold text-white flex items-center space-x-2">
          <i data-lucide="book-open" class="w-4 h-4 text-purple-400"></i>
          <span>Interview Technical Deep-Dive: Architectural Resilience</span>
        </h2>
        <p class="text-slate-400 text-xs mt-1">Here is how PreJOSAA defends against ransomware, malicious wipes, and exfiltration:</p>
      </div>

      <div class="space-y-4">
        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <div class="flex items-center space-x-2 text-white font-bold">
            <span class="w-5 h-5 rounded-full bg-purple-600 text-[11px] flex items-center justify-center">1</span>
            <span>Immutable-by-Design Data Layer</span>
          </div>
          <p class="text-slate-400 text-[11px] leading-relaxed">
            All user deletions are soft deletes (<code class="text-sky-300">is_deleted = 1</code>, <code class="text-sky-300">deleted_at = timestamp</code>). Every insert, update, and soft-delete logs a tamper-evident entry to the append-only <code class="text-sky-300">audit_logs</code> table. A dedicated <code class="text-sky-300">record_versions</code> table maintains complete before/after snapshots and delta summaries.
          </p>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <div class="flex items-center space-x-2 text-white font-bold">
            <span class="w-5 h-5 rounded-full bg-purple-600 text-[11px] flex items-center justify-center">2</span>
            <span>Automated "Validated Clean" Recovery Points</span>
          </div>
          <p class="text-slate-400 text-[11px] leading-relaxed">
            Traditional backups risk saving corrupted data. PreJOSAA runs an automated 4-stage validation suite (<code class="text-sky-300">PRAGMA integrity_check</code>, <code class="text-sky-300">PRAGMA foreign_key_check</code>, table existence and minimum row count audits, smoke query join benchmarks) immediately after snapshotting. Only databases passing 100% of checks are promoted to "Validated Clean" and indexed by SHA-256 hash.
          </p>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <div class="flex items-center space-x-2 text-white font-bold">
            <span class="w-5 h-5 rounded-full bg-purple-600 text-[11px] flex items-center justify-center">3</span>
            <span>Emergency Containment Kill-Switch</span>
          </div>
          <p class="text-slate-400 text-[11px] leading-relaxed">
            Real-time threat heuristics detect anomalies (spikes in failed logins, mass deletion attempts, export bursts). If an incident occurs, operators or automated circuit-breakers activate Containment Mode, globally locking all deletes and exports across the site with HTTP 423 Locked.
          </p>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <div class="flex items-center space-x-2 text-white font-bold">
            <span class="w-5 h-5 rounded-full bg-purple-600 text-[11px] flex items-center justify-center">4</span>
            <span>Zero Trust Access &amp; Step-Up Authentication</span>
          </div>
          <p class="text-slate-400 text-[11px] leading-relaxed">
            Role-based access control enforces least privilege. Privileged operations (database rollback, containment mode toggles, mass exports) require Step-Up Authentication, issuing a temporary 5-minute clearance token upon password re-authentication.
          </p>
        </div>
      </div>

      <!-- CLI Test Command Callout -->
      <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 text-xs space-y-2">
        <span class="font-bold text-slate-200 block uppercase tracking-wider text-[11px]">Command Line Verification Command for Evaluators:</span>
        <code class="block p-3 rounded-lg bg-black text-emerald-400 font-mono text-xs overflow-x-auto">
          node scripts/simulate_ransomware_drill.js
        </code>
      </div>

    </div>

  </main>
</div>

<script>
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
</script>
<%- include('../../partials/footer') %>
