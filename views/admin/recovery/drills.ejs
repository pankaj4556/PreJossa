<%- include('../../partials/head', { title: 'Restore Drills & RTO Benchmarking — Recovery Center' }) %>

<div class="min-h-screen bg-slate-900 text-white flex flex-col">
  <%- include('./nav', { activeTab: 'drills' }) %>

  <main class="flex-1 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight">Restore Drills &amp; RTO Benchmarks</h1>
        <p class="text-xs text-slate-400 mt-1">Non-destructive sandbox drills simulate full restoration to prove recovery capabilities and measure empirical RTO.</p>
      </div>

      <div class="flex items-center space-x-2">
        <form method="POST" action="<%= recoveryRoutePath %>/drills/run" class="inline">
          <button type="submit" class="px-4 py-2 rounded-xl bg-sky-600 hover:bg-sky-500 text-xs font-bold transition flex items-center space-x-1.5 shadow-md shadow-sky-950/40">
            <i data-lucide="play" class="w-4 h-4"></i>
            <span>Execute Immediate Drill</span>
          </button>
        </form>
      </div>
    </div>

    <% if (flash) { %>
      <div class="p-4 rounded-xl text-xs font-medium flex items-center space-x-2 <%= flashType === 'success' ? 'bg-emerald-950/80 border border-emerald-700/60 text-emerald-200' : 'bg-red-950/80 border border-red-700/60 text-red-200' %>">
        <i data-lucide="<%= flashType === 'success' ? 'check-circle' : 'alert-octagon' %>" class="w-4 h-4 flex-shrink-0"></i>
        <span><%= flash %></span>
      </div>
    <% } %>

    <!-- Drill Results Certificate (If just executed) -->
    <% if (drillResult) { %>
      <div class="p-6 rounded-2xl bg-gradient-to-r from-slate-800 via-slate-800 to-sky-950/40 border border-sky-500/40 shadow-xl space-y-4 animate-in fade-in">
        <div class="flex items-center justify-between border-b border-slate-700/80 pb-4">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/40 flex items-center justify-center text-sky-400">
              <i data-lucide="award" class="w-5 h-5"></i>
            </div>
            <div>
              <span class="text-xs font-bold text-sky-400 uppercase tracking-widest block text-[10px]">Restoration Drill Certificate</span>
              <h2 class="text-base font-bold text-white">Non-Destructive Sandbox Drill Completed</h2>
            </div>
          </div>
          <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-950 border border-emerald-700 text-emerald-300">
            STATUS: <%= drillResult.status %>
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 text-xs">
          <div class="p-3 rounded-xl bg-slate-900/60 border border-slate-800">
            <span class="text-slate-400 text-[10px] uppercase font-bold block">Measured RTO</span>
            <div class="text-2xl font-black font-mono text-emerald-400 mt-1"><%= drillResult.rtoSeconds %>s</div>
            <span class="text-[10px] text-slate-400">Target SLA: &lt; <%= stats.sla.targetRtoMinutes %>m</span>
          </div>

          <div class="p-3 rounded-xl bg-slate-900/60 border border-slate-800">
            <span class="text-slate-400 text-[10px] uppercase font-bold block">Integrity Check</span>
            <div class="text-2xl font-black font-mono text-emerald-400 mt-1"><%= drillResult.validationReport.integrityCheck %></div>
            <span class="text-[10px] text-slate-400">PRAGMA integrity_check</span>
          </div>

          <div class="p-3 rounded-xl bg-slate-900/60 border border-slate-800">
            <span class="text-slate-400 text-[10px] uppercase font-bold block">Foreign Key Constraints</span>
            <div class="text-2xl font-black font-mono text-emerald-400 mt-1"><%= drillResult.validationReport.foreignKeys %></div>
            <span class="text-[10px] text-slate-400">0 FK Violations</span>
          </div>

          <div class="p-3 rounded-xl bg-slate-900/60 border border-slate-800">
            <span class="text-slate-400 text-[10px] uppercase font-bold block">Target Sandbox</span>
            <div class="text-sm font-bold text-slate-200 mt-2 truncate">Isolated Temp DB</div>
            <span class="text-[10px] text-slate-400">Auto-purged after test</span>
          </div>
        </div>

        <!-- Smoke Query Check Summary -->
        <div class="p-3 rounded-xl bg-slate-900/80 border border-slate-800 space-y-2 text-xs">
          <strong class="text-slate-200 text-[11px] block uppercase font-bold tracking-wider">Automated Query Smoke Tests:</strong>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-[11px]">
            <% (drillResult.validationReport.smokeQueries || []).forEach(sq => { %>
              <div class="flex items-center justify-between p-2 rounded bg-slate-800/60 border border-slate-700/50">
                <span class="text-slate-300 font-medium"><%= sq.name %></span>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold <%= sq.status === 'PASS' ? 'bg-emerald-950 text-emerald-400' : 'bg-amber-950 text-amber-400' %>">
                  <%= sq.status %>
                </span>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Drill History Table -->
    <div class="rounded-2xl bg-slate-800 border border-slate-700/80 overflow-hidden shadow-xl">
      <div class="px-5 py-4 border-b border-slate-700/80 flex items-center justify-between">
        <h2 class="text-sm font-bold text-white flex items-center space-x-2">
          <i data-lucide="history" class="w-4 h-4 text-sky-400"></i>
          <span>Historical Restore Drills &amp; Certifications</span>
        </h2>
        <span class="text-xs text-slate-400 font-mono"><%= stats.recentDrills.length %> Recorded</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-900/80 border-b border-slate-700/80 text-slate-400 font-semibold uppercase tracking-wider text-[10px]">
            <tr>
              <th class="px-4 py-3">Timestamp / Actor</th>
              <th class="px-4 py-3">Type &bull; Target</th>
              <th class="px-4 py-3">Source Backup Point</th>
              <th class="px-4 py-3">Measured RTO</th>
              <th class="px-4 py-3">Integrity Verdict</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-700/50">
            <% if (stats.recentDrills.length === 0) { %>
              <tr>
                <td colspan="5" class="px-4 py-8 text-center text-slate-400">No restore drills logged yet. Click "Execute Immediate Drill" above.</td>
              </tr>
            <% } %>
            <% stats.recentDrills.forEach(d => { %>
              <tr class="hover:bg-slate-700/30 transition">
                <td class="px-4 py-3">
                  <div class="font-medium text-slate-200"><%= d.executed_at %></div>
                  <div class="text-[10px] text-slate-400">By: <strong class="text-slate-300"><%= d.executed_by %></strong></div>
                </td>
                <td class="px-4 py-3">
                  <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-700 text-slate-200">
                    <%= d.drill_type %>
                  </span>
                  <div class="text-[10px] text-slate-400 font-mono mt-0.5"><%= d.target_instance %></div>
                </td>
                <td class="px-4 py-3 font-mono text-[11px] text-slate-300">
                  <%= d.backup_filename || ('Backup #' + d.backup_id) %>
                </td>
                <td class="px-4 py-3 font-mono font-bold text-emerald-400 text-sm">
                  <%= d.rto_seconds %>s
                </td>
                <td class="px-4 py-3">
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold <%= d.status === 'PASSED' ? 'bg-emerald-950 border border-emerald-700 text-emerald-400' : 'bg-red-950 border border-red-700 text-red-400' %>">
                    <%= d.status %>
                  </span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

  </main>
</div>

<script>
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
</script>
<%- include('../../partials/footer') %>
