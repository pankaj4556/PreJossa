<%- include('../partials/head', { title: 'Admin CSV Imports' }) %>

<div class="min-h-screen bg-slate-900 text-white flex flex-col">
  <header class="border-b border-slate-800 bg-slate-950/80 sticky top-0 z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-8 h-8 rounded-lg bg-sky-600 flex items-center justify-center font-bold">
          <i data-lucide="shield" class="w-4 h-4"></i>
        </div>
        <span class="font-bold text-slate-100 tracking-tight">PreJOSAA Admin</span>
      </div>

      <nav class="hidden md:flex items-center space-x-1 text-xs font-semibold">
        <a href="<%= adminRoutePath %>" class="px-3 py-1.5 rounded-lg text-slate-400 hover:text-white transition">Dashboard</a>
        <a href="<%= adminRoutePath %>/payments" class="px-3 py-1.5 rounded-lg text-slate-400 hover:text-white transition">Payment History</a>
        <a href="<%= adminRoutePath %>/audit" class="px-3 py-1.5 rounded-lg text-slate-400 hover:text-white transition">Data Audit</a>
        <a href="<%= adminRoutePath %>/imports" class="px-3 py-1.5 rounded-lg bg-slate-800 text-sky-400">CSV Imports</a>
        <a href="<%= adminRoutePath %>/settings" class="px-3 py-1.5 rounded-lg text-slate-400 hover:text-white transition">Settings</a>
      </nav>

      <div class="flex items-center space-x-3 text-xs">
        <span class="text-slate-400">Admin: <strong class="text-slate-200"><%= admin.username %></strong></span>
        <a href="<%= adminRoutePath %>/logout" class="px-3 py-1.5 rounded-lg bg-red-900/30 text-red-400 hover:bg-red-900/50 transition">Log Out</a>
      </div>
    </div>
  </header>

  <main class="flex-1 max-w-4xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight">Data Import & Yearly Update Logs</h1>
      <p class="text-xs text-slate-400 mt-1">Per Section 13 & 16: Upload new JoSAA season cutoffs, seat matrices, or NIRF ranking releases via validated CSV.</p>
    </div>

    <!-- Upload Box -->
    <div class="p-6 rounded-2xl bg-slate-800 border border-slate-700 space-y-4">
      <h2 class="text-sm font-bold text-white uppercase tracking-wider border-b border-slate-700 pb-2">Upload Dataset CSV</h2>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
        <div>
          <label class="block font-bold text-slate-300 uppercase tracking-wider mb-1">Dataset Type</label>
          <select class="w-full px-3 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white text-xs">
            <option>JoSAA Closing Ranks (Archive CSV)</option>
            <option>NIRF Engineering Rankings CSV</option>
            <option>Institute Placement Statistics CSV</option>
            <option>Seat Matrix CSV</option>
          </select>
        </div>

        <div>
          <label class="block font-bold text-slate-300 uppercase tracking-wider mb-1">Target Season Year</label>
          <input type="number" value="2025" class="w-full px-3 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white text-xs font-mono">
        </div>
      </div>

      <div>
        <label class="block font-bold text-slate-300 uppercase tracking-wider mb-1 text-xs">CSV File</label>
        <input type="file" accept=".csv" class="w-full text-xs text-slate-400 file:mr-3 file:py-2 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-sky-900/50 file:text-sky-300 hover:file:bg-sky-800/50 cursor-pointer">
      </div>

      <div class="pt-2 flex justify-end">
        <button type="button" onclick="alert('Demo Mode: In production, upload parses and validates CSV rows against SQLite schema before committing.')" class="px-5 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-bold text-xs shadow transition flex items-center space-x-1.5">
          <i data-lucide="upload" class="w-4 h-4"></i>
          <span>Upload & Preview Import</span>
        </button>
      </div>
    </div>

    <!-- Import Logs Table -->
    <div class="bg-slate-800 rounded-2xl border border-slate-700 overflow-hidden shadow-xl p-6 space-y-4">
      <h2 class="text-sm font-bold text-white uppercase tracking-wider border-b border-slate-700 pb-2">Historical Dataset Import Logs</h2>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead class="bg-slate-900/80 text-slate-400 uppercase text-[10px] font-bold">
            <tr>
              <th class="py-2.5 px-3">Dataset Name</th>
              <th class="py-2.5 px-3 text-center">Data Year</th>
              <th class="py-2.5 px-3 text-center">Rows Committed</th>
              <th class="py-2.5 px-3 text-right">Import Timestamp</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-700 font-mono">
            <% logs.forEach(log => { %>
              <tr>
                <td class="py-2.5 px-3 font-sans font-bold text-slate-200"><%= log.dataset %></td>
                <td class="py-2.5 px-3 text-center text-sky-400"><%= log.year %></td>
                <td class="py-2.5 px-3 text-center text-emerald-400"><%= log.rows %></td>
                <td class="py-2.5 px-3 text-right text-slate-400 text-[10px] font-sans"><%= log.imported_at %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

  </main>
</div>

<script>
  if (window.lucide) window.lucide.createIcons();
</script>
</body>
</html>
