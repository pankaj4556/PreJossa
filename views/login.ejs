<%- include('partials/head', { title: 'Sign In — PreJOSAA' }) %>
<%- include('partials/header') %>

<div class="max-w-md mx-auto px-4 py-16 sm:px-6">
  <div class="bg-white rounded-3xl border border-slate-200/90 shadow-xl p-6 sm:p-9 space-y-6">
    <div class="text-center">
      <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold mx-auto mb-3 border border-blue-100">
        <i data-lucide="lock" class="w-6 h-6"></i>
      </div>
      <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Sign in to <%= site.name %></h1>
      <p class="text-xs text-slate-500 mt-1">Access your saved choice lists and verified downloads</p>
    </div>

    <form id="loginForm" class="space-y-4">
      <input type="hidden" id="returnToInput" value="<%= returnTo %>">

      <div>
        <label for="loginEmail" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Email Address</label>
        <input type="email" id="loginEmail" name="email" required placeholder="student@example.com"
               class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-slate-900">
      </div>

      <div>
        <label for="loginPassword" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Password</label>
        <input type="password" id="loginPassword" name="password" required placeholder="••••••••"
               class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-slate-900">
      </div>

      <div id="loginError" class="hidden text-xs text-rose-600 bg-rose-50 border border-rose-200 p-3 rounded-xl"></div>

      <button type="submit" id="loginBtn" class="w-full py-3.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm shadow-md transition">
        Sign In
      </button>
    </form>

    <div class="text-center text-xs text-slate-500 border-t border-slate-100 pt-4">
      Don't have an account? <a href="/signup?returnTo=<%= encodeURIComponent(returnTo) %>" class="font-bold text-blue-600 hover:underline">Create an account</a>
    </div>
  </div>
</div>

<script>
  const form = document.getElementById('loginForm');
  const errBox = document.getElementById('loginError');
  const btn = document.getElementById('loginBtn');
  const returnTo = document.getElementById('returnToInput').value || '/';

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errBox.classList.add('hidden');
    btn.disabled = true;
    btn.textContent = 'Signing In...';

    try {
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: document.getElementById('loginEmail').value,
          password: document.getElementById('loginPassword').value
        })
      });
      const data = await res.json();
      if (data.success) {
        window.location.href = returnTo;
      } else {
        errBox.textContent = data.message || 'Login failed.';
        errBox.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = 'Sign In';
      }
    } catch (err) {
      errBox.textContent = 'Network error.';
      errBox.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'Sign In';
    }
  });
</script>

<%- include('partials/footer') %>
