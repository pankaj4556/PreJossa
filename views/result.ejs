<%- include('partials/head', { title: 'Your JoSAA Choice List — PreJOSAA' }) %>
<%- include('partials/header') %>

<div class="max-w-7xl mx-auto px-4 py-8 sm:py-12 sm:px-6 lg:px-8">
  
  <!-- Header & Summary Banner -->
  <div class="bg-white rounded-3xl border border-slate-200/90 shadow-md p-6 sm:p-8 mb-6">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-6 border-b border-slate-100">
      <div>
        <div class="inline-flex items-center space-x-2 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200/80 text-emerald-700 text-xs font-semibold mb-2.5">
          <i data-lucide="check-circle" class="w-3.5 h-3.5 text-emerald-600"></i>
          <span>Official Choice Sequence Calibrated • 2024 Cutoff Archive</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Your Generated JoSAA Choice List
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1 max-w-2xl">
          Review, drag to reorder, or remove choices before downloading. Choices are formatted for direct sequential entry into the official JoSAA portal.
        </p>
      </div>

      <!-- Action Buttons: Save, Print, Downloads -->
      <div class="flex flex-wrap items-center gap-2.5">
        <button id="saveChangesBtn" class="hidden px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold shadow transition flex items-center space-x-1.5">
          <i data-lucide="save" class="w-3.5 h-3.5"></i>
          <span>Save Changes</span>
        </button>

        <button onclick="window.print()" class="px-4 py-2.5 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-bold transition flex items-center space-x-1.5 no-print shadow-2xs">
          <i data-lucide="printer" class="w-3.5 h-3.5 text-slate-500"></i>
          <span>Print</span>
        </button>

        <!-- Download Buttons (Protected by ₹49 Payment / Login) -->
        <div class="inline-flex rounded-xl shadow-xs no-print overflow-hidden" role="group">
          <button type="button" class="download-trigger-btn px-4 py-2.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 border-r border-blue-500 transition flex items-center space-x-1.5" data-format="pdf">
            <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
            <span>PDF</span>
          </button>
          <button type="button" class="download-trigger-btn px-3.5 py-2.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 border-r border-blue-500 transition flex items-center space-x-1" data-format="xlsx">
            <i data-lucide="table" class="w-3.5 h-3.5"></i>
            <span>Excel</span>
          </button>
          <button type="button" class="download-trigger-btn px-3.5 py-2.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 border-r border-blue-500 transition flex items-center space-x-1" data-format="docx">
            <i data-lucide="file" class="w-3.5 h-3.5"></i>
            <span>Word</span>
          </button>
          <button type="button" class="download-trigger-btn px-3 py-2.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 transition flex items-center space-x-1" data-format="csv">
            <i data-lucide="code" class="w-3.5 h-3.5"></i>
            <span>CSV</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Student Inputs & Metadata Badges -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3.5 pt-6 text-xs">
      <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100">
        <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wider">JEE Main Rank</span>
        <span class="text-base font-extrabold text-slate-900 font-mono">#<%= inputs.jeeMainRank || '-' %></span>
      </div>
      <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100">
        <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wider">JEE Adv. Rank</span>
        <span class="text-base font-extrabold text-slate-900 font-mono"><%= inputs.jeeAdvRank ? '#' + inputs.jeeAdvRank : 'N/A' %></span>
      </div>
      <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100">
        <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wider">Category &amp; Quota</span>
        <span class="text-xs font-bold text-slate-900 truncate block mt-0.5"><%= inputs.category %> (<%= inputs.homeState ? inputs.homeState.substring(0, 8) : 'AI' %>)</span>
      </div>
      <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100">
        <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wider">Total Choices</span>
        <span class="text-base font-extrabold text-blue-700 font-mono" id="totalChoicesCount"><%= summary.totalChoices %></span>
      </div>
      <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100">
        <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wider">Risk Breakdown</span>
        <div class="flex items-center space-x-1.5 mt-1 font-mono text-[11px] font-bold">
          <span class="text-emerald-700"><%= summary.safeCount %> S</span> • 
          <span class="text-amber-700"><%= summary.moderateCount %> M</span> • 
          <span class="text-rose-700"><%= summary.ambitiousCount %> A</span>
        </div>
      </div>
      <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100">
        <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wider">Priority Logic</span>
        <span class="text-[11px] font-bold text-slate-800 uppercase tracking-tight truncate block mt-0.5">
          <%= inputs.priorityOrder ? inputs.priorityOrder.join(' > ') : 'Branch > NIRF' %>
        </span>
      </div>
    </div>
  </div>

  <!-- Table Filter & Toolbar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4 no-print">
    <!-- Filter Chips for Result View -->
    <div class="flex flex-wrap items-center gap-1.5" id="resultFilterTabs">
      <button type="button" class="res-filter-tab active px-3 py-1.5 rounded-xl text-xs font-bold bg-blue-600 text-white shadow-xs transition" data-filter="ALL">All (<%= choices.length %>)</button>
      <button type="button" class="res-filter-tab px-3 py-1.5 rounded-xl text-xs font-semibold bg-white border border-slate-200 text-emerald-800 hover:bg-emerald-50 transition" data-filter="Safe">Safe (<%= summary.safeCount %>)</button>
      <button type="button" class="res-filter-tab px-3 py-1.5 rounded-xl text-xs font-semibold bg-white border border-slate-200 text-amber-800 hover:bg-amber-50 transition" data-filter="Moderate">Moderate (<%= summary.moderateCount %>)</button>
      <button type="button" class="res-filter-tab px-3 py-1.5 rounded-xl text-xs font-semibold bg-white border border-slate-200 text-rose-800 hover:bg-rose-50 transition" data-filter="Ambitious">Ambitious (<%= summary.ambitiousCount %>)</button>
      <button type="button" class="res-filter-tab px-3 py-1.5 rounded-xl text-xs font-semibold bg-white border border-slate-200 text-indigo-800 hover:bg-indigo-50 transition" data-filter="IIT">IITs Only</button>
      <button type="button" class="res-filter-tab px-3 py-1.5 rounded-xl text-xs font-semibold bg-white border border-slate-200 text-amber-900 hover:bg-amber-50 transition" data-filter="NIT">NITs Only</button>
    </div>

    <div class="text-xs text-slate-500 flex items-center space-x-1.5 self-start sm:self-auto">
      <i data-lucide="arrow-up-down" class="w-3.5 h-3.5 text-blue-600"></i>
      <span>Use arrows to reorder • Changes auto-save</span>
    </div>
  </div>

  <!-- Choice Table Container -->
  <div class="bg-white rounded-3xl border border-slate-200/90 shadow-md overflow-hidden mb-8">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse" id="choiceTable">
        <thead>
          <tr class="bg-slate-900 text-white uppercase text-[10px] font-bold tracking-wider">
            <th class="py-3.5 px-3 text-center w-14">#</th>
            <th class="py-3.5 px-4">Institute</th>
            <th class="py-3.5 px-4">Academic Program / Branch</th>
            <th class="py-3.5 px-3 text-center">Quota</th>
            <th class="py-3.5 px-3 text-center">2024 Cutoff</th>
            <th class="py-3.5 px-3 text-center">Risk Tier</th>
            <th class="py-3.5 px-3 text-center">NIRF Rank</th>
            <th class="py-3.5 px-3 text-center">Avg Package</th>
            <th class="py-3.5 px-3 text-center no-print">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100" id="choiceTableBody">
          <% choices.forEach((c, index) => { %>
            <tr class="choice-row hover:bg-slate-50/80 transition" 
                data-id="<%= c.closing_rank_id %>"
                data-choice-number="<%= c.choice_number %>"
                data-institute-name="<%= c.institute_name %>"
                data-institute-type="<%= c.institute_type %>"
                data-josaa-code="<%= c.josaa_code %>"
                data-branch-name="<%= c.branch_name %>"
                data-quota="<%= c.quota %>"
                data-seat-type="<%= c.seat_type %>"
                data-gender-pool="<%= c.gender_pool %>"
                data-closing-rank="<%= c.closing_rank %>"
                data-chance="<%= c.chance %>"
                data-nirf-rank="<%= c.nirf_rank %>"
                data-avg-lpa="<%= c.avg_placement_lpa %>">
              
              <!-- Choice Number -->
              <td class="py-3 px-3 text-center font-bold text-slate-800 font-mono choice-num">
                <%= c.choice_number %>
              </td>

              <!-- Institute Name & Code -->
              <td class="py-3 px-4 font-semibold text-slate-900">
                <a href="/college/<%= c.josaa_code %>" class="hover:text-blue-600 transition flex items-center space-x-1.5 group">
                  <span class="px-2 py-0.5 rounded-md text-[10px] font-mono font-bold <%= c.institute_type === 'IIT' ? 'bg-indigo-50 text-indigo-700 border border-indigo-200' : 'bg-amber-50 text-amber-800 border border-amber-200' %>">
                    <%= c.josaa_code %>
                  </span>
                  <span class="truncate max-w-xs sm:max-w-sm group-hover:underline"><%= c.institute_name %></span>
                </a>
                <span class="text-[10px] text-slate-400 block font-normal"><%= c.city %>, <%= c.institute_state %></span>
              </td>

              <!-- Branch & Degree -->
              <td class="py-3 px-4 text-slate-700">
                <span class="font-bold text-slate-900 block"><%= c.branch_name %></span>
                <span class="text-[10px] text-slate-400 font-mono"><%= c.degree || 'B.Tech' %> • <%= c.duration_years || 4 %> Years</span>
              </td>

              <!-- Quota -->
              <td class="py-3 px-3 text-center font-mono font-semibold text-slate-600">
                <span class="px-2 py-0.5 rounded-md bg-slate-100 border border-slate-200 text-[11px]"><%= c.quota || 'AI' %></span>
              </td>

              <!-- Cutoff Closing Rank -->
              <td class="py-3 px-3 text-center font-mono font-extrabold text-slate-900">
                <%= c.closing_rank.toLocaleString() %>
              </td>

              <!-- Chance Badge -->
              <td class="py-3 px-3 text-center">
                <% if (c.chance === 'Safe') { %>
                  <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">Safe</span>
                <% } else if (c.chance === 'Moderate') { %>
                  <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-50 text-amber-800 border border-amber-200">Moderate</span>
                <% } else { %>
                  <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-rose-50 text-rose-700 border border-rose-200">Ambitious</span>
                <% } %>
              </td>

              <!-- NIRF Rank -->
              <td class="py-3 px-3 text-center font-mono font-bold text-slate-700">
                <%= c.nirf_rank ? '#' + c.nirf_rank : 'N/A' %>
              </td>

              <!-- Average Placement LPA -->
              <td class="py-3 px-3 text-center font-mono font-bold text-slate-800">
                <%= c.avg_placement_lpa ? '₹' + c.avg_placement_lpa + ' L' : 'N/A' %>
              </td>

              <!-- On-Screen Actions -->
              <td class="py-3 px-3 text-center no-print">
                <div class="flex items-center justify-center space-x-1">
                  <button type="button" class="p-1.5 rounded-lg text-slate-400 hover:text-slate-800 hover:bg-slate-100 row-up-btn transition" title="Move Up">
                    <i data-lucide="chevron-up" class="w-4 h-4"></i>
                  </button>
                  <button type="button" class="p-1.5 rounded-lg text-slate-400 hover:text-slate-800 hover:bg-slate-100 row-down-btn transition" title="Move Down">
                    <i data-lucide="chevron-down" class="w-4 h-4"></i>
                  </button>
                  <button type="button" class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 row-delete-btn transition ml-1" title="Remove Choice">
                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Mandatory Legal Disclaimer -->
  <div class="p-4.5 rounded-2xl bg-slate-50 border border-slate-200 text-xs text-slate-500 leading-relaxed mb-12">
    <strong class="text-slate-800">Official JoSAA Disclaimer:</strong> Results are computed from official previous-year opening and closing ranks and NIRF Engineering rankings published by the Ministry of Education. They serve strictly as strategic counselling decision support and do not constitute an official seat guarantee.
  </div>

</div>

<!-- Hidden inputs for JS state -->
<input type="hidden" id="currentChoiceListId" value="<%= choiceListId %>">
<input type="hidden" id="userIsLoggedIn" value="<%= user ? 'true' : 'false' %>">
<input type="hidden" id="isPurchaseUnlocked" value="<%= paymentStatus.isUnlocked ? 'true' : 'false' %>">

<%- include('partials/payment-modal') %>
<script src="/js/payment.js"></script>
<script src="/js/result.js"></script>
<%- include('partials/footer') %>
