<%- include('partials/head', { title: 'Create Account — PreJOSAA' }) %>
<%- include('partials/header') %>

<div class="max-w-md mx-auto px-4 py-16 sm:px-6">
  <div class="bg-white rounded-3xl border border-slate-200/90 shadow-xl p-6 sm:p-9 space-y-6">
    <div class="text-center">
      <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold mx-auto mb-3 border border-blue-100">
        <i data-lucide="user-plus" class="w-6 h-6"></i>
      </div>
      <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Create an Account</h1>
      <p class="text-xs text-slate-500 mt-1">Register to download and manage your JoSAA choice lists</p>
    </div>

    <form id="signupForm" class="space-y-4">
      <input type="hidden" id="returnToInput" value="<%= returnTo %>">

      <div>
        <label for="signupName" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Full Name</label>
        <input type="text" id="signupName" name="name" required placeholder="e.g. Priya Sharma"
               class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-slate-900">
      </div>

      <div>
        <label for="signupEmail" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Email Address</label>
        <input type="email" id="signupEmail" name="email" required placeholder="priya@example.com"
               class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-slate-900">
      </div>

      <div>
        <label for="signupMobile" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Mobile Number (Optional)</label>
        <input type="tel" id="signupMobile" name="mobile" placeholder="9876543210"
               class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-slate-900 font-mono">
      </div>

      <div>
        <label for="signupPassword" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Password</label>
        <input type="password" id="signupPassword" name="password" required minlength="6" placeholder="At least 6 characters"
               class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-slate-900">
      </div>

      <div id="signupError" class="hidden text-xs text-rose-600 bg-rose-50 border border-rose-200 p-3 rounded-xl"></div>

      <button type="submit" id="signupBtn" class="w-full py-3.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm shadow-md transition">
        Create Account
      </button>
    </form>

    <div class="text-center text-xs text-slate-500 border-t border-slate-100 pt-4">
      Already have an account? <a href="/login?returnTo=<%= encodeURIComponent(returnTo) %>" class="font-bold text-blue-600 hover:underline">Sign In</a>
    </div>
  </div>
</div>

<script>
  const form = document.getElementById('signupForm');
  const errBox = document.getElementById('signupError');
  const btn = document.getElementById('signupBtn');
  const returnTo = document.getElementById('returnToInput').value || '/';

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errBox.classList.add('hidden');
    btn.disabled = true;
    btn.textContent = 'Creating Account...';

    try {
      const res = await fetch('/api/auth/signup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: document.getElementById('signupName').value,
          email: document.getElementById('signupEmail').value,
          mobile: document.getElementById('signupMobile').value,
          password: document.getElementById('signupPassword').value
        })
      });
      const data = await res.json();
      if (data.success) {
        window.location.href = returnTo;
      } else {
        errBox.textContent = data.message || 'Signup failed.';
        errBox.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = 'Create Account';
      }
    } catch (err) {
      errBox.textContent = 'Network error.';
      errBox.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'Create Account';
    }
  });
</script>

<%- include('partials/footer') %>
